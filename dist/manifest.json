{
  "manifest_version": 3,
  "name": "ToS Risk Analyzer - Jev & PageAgent",
  "version": "1.0",
  "description": "Alibaba Page Agent ve Jev TypeSafe AI destekli risk analizörü.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}